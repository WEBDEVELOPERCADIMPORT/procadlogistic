---
import Layout from '../layouts/Layout.astro';
import globalContent from '../data/site-global-content.json';
import { getLangFromUrl } from '../i18n/utils.i18n';

const lang = getLangFromUrl(Astro.url);
const t = globalContent[lang]?.notFound ?? globalContent.es.notFound;
---

<Layout title={t.title} lang={lang}>
  <section class="h-screen flex flex-col justify-center items-center text-center p-5">
    <h1 class="text-9xl font-black text-gray-200">{t.heading}</h1>
    <p class="text-2xl font-bold text-gray-800 mt-4">{t.subheading}</p>
    <p class="text-gray-500 mt-2 mb-8">{t.message}</p>
    <a 
      href={`/${lang}/`} 
      class="bg-[#00aeef] hover:bg-[#0098d4] text-white px-8 py-3 font-bold uppercase tracking-wider transition"
    >
      {t.backHome}
    </a>
  </section>
</Layout>

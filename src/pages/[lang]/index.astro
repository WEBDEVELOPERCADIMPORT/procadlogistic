---
import Layout from '../../layouts/Layout.astro';
import homeContent from '../../data/site-home-content.json';
import { LANGUAGES, type Lang } from '../../i18n/config.i18n';
import HeroSection from '../../components/home/sections/HeroSection.astro';
import IntroOverviewSection from '../../components/home/sections/IntroOverviewSection.astro';
import AudienceCardsSection from '../../components/home/sections/AudienceCardsSection.astro';
import VisionFutureSection from '../../components/home/sections/VisionFutureSection.astro';
import LocationsMapSection from '../../components/home/sections/LocationsMapSection.astro';
import HomeContactSection from '../../components/home/sections/HomeContactSection.astro';

const lang = Astro.params.lang as Lang;

// 1. Validar idioma
if (!(lang in LANGUAGES) || !(lang in homeContent)) {
  return Astro.redirect('/404');
}

const content = homeContent[lang];
---

<Layout
  title={content.meta.title}
  lang={lang}
  description={content.meta.description}
>
  <main class="w-full bg-white">
    <HeroSection lang={lang} />
    <IntroOverviewSection lang={lang} />
    <AudienceCardsSection lang={lang} />
    <VisionFutureSection lang={lang} />
    <LocationsMapSection lang={lang} />
    <HomeContactSection lang={lang} />
  </main>
</Layout>

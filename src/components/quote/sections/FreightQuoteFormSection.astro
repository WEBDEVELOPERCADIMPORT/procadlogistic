---
import type { Lang } from '../../../i18n/config.i18n';
import type { ServiceItem } from '../../../actions/services/services.action';

interface Props {
  lang: Lang;
  service?: ServiceItem;
}

const { lang, service } = Astro.props;

const labels = {
  firstName: lang === 'es' ? 'Nombre' : 'First Name',
  lastName: lang === 'es' ? 'Apellido' : 'Last Name',
  company: lang === 'es' ? 'Nombre de la Empresa' : 'Company Name',
  email: lang === 'es' ? 'Dirección de Correo Electrónico' : 'Email Address',
  commodity: lang === 'es' ? 'Mercancía / Producto' : 'Commodity',
  pickupZip: lang === 'es' ? 'Código Postal de Recolección' : 'Pick Up Zip',
  deliveryZip: lang === 'es' ? 'Código Postal de Entrega' : 'Delivery Zip',
  pickupDate: lang === 'es' ? 'Fecha de Recolección' : 'Pick Up Date',
  subject: lang === 'es' ? 'Asunto' : 'Subject',
  details: lang === 'es' ? 'Cuéntenos lo que necesita...' : 'Tell us what you need...',
  submit: lang === 'es' ? 'ENVIAR' : 'SUBMIT',
};

const defaultSubject = service 
  ? (lang === 'es' ? `Cotización para ${service.title.es}` : `Quote for ${service.title.en}`)
  : '';
---

<section class="w-full bg-white py-16 sm:py-24 text-neutral-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <form id="freight-quote-details-form" class="space-y-6">
      
      <!-- Row 1: First Name & Last Name -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="quote-first-name" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {labels.firstName} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-first-name"
            name="firstName"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>

        <div>
          <label for="quote-last-name" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {labels.lastName} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-last-name"
            name="lastName"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>
      </div>

      <!-- Row 2: Company Name & Email Address -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="quote-company" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {labels.company} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-company"
            name="company"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>

        <div>
          <label for="quote-email" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {labels.email} <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="quote-email"
            name="email"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>
      </div>

      <!-- Row 3: Commodity -->
      <div>
        <label for="quote-commodity" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
          {labels.commodity} <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="quote-commodity"
          name="commodity"
          required
          class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
        />
      </div>

      <!-- Row 4: Pick Up Zip, Delivery Zip, Pick Up Date -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div>
          <label for="quote-pickup-zip" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {labels.pickupZip} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-pickup-zip"
            name="pickupZip"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>

        <div>
          <label for="quote-delivery-zip" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {labels.deliveryZip} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-delivery-zip"
            name="deliveryZip"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>

        <div>
          <label for="quote-pickup-date" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {labels.pickupDate} <span class="text-red-500">*</span>
          </label>
          <input
            type="date"
            id="quote-pickup-date"
            name="pickupDate"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>
      </div>

      <!-- Row 5: Subject -->
      <div>
        <label for="quote-subject" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
          {labels.subject}
        </label>
        <input
          type="text"
          id="quote-subject"
          name="subject"
          value={defaultSubject}
          class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
        />
      </div>

      <!-- Row 6: Tell us what you need... -->
      <div>
        <label for="quote-details" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
          {labels.details} <span class="text-red-500">*</span>
        </label>
        <textarea
          id="quote-details"
          name="details"
          rows="5"
          required
          class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
        ></textarea>
      </div>

      <div id="quote-form-feedback" class="hidden p-3 bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold"></div>

      <!-- Centered Dark SUBMIT Button #222222 -->
      <div class="text-center pt-6">
        <button
          type="submit"
          id="quote-submit-btn"
          class="inline-block bg-[#222222] hover:bg-black text-white text-xs font-black uppercase tracking-widest px-14 py-4 rounded-none transition-colors"
        >
          {labels.submit}
        </button>
      </div>

    </form>

  </div>
</section>

<script>
  function setupQuoteForm() {
    const form = document.getElementById('freight-quote-details-form') as HTMLFormElement | null;
    const feedback = document.getElementById('quote-form-feedback');
    const btn = document.getElementById('quote-submit-btn') as HTMLButtonElement | null;

    if (!form || !feedback || !btn) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = '...';

      setTimeout(() => {
        btn.disabled = false;
        btn.textContent = 'ENVIADO';
        feedback.textContent = '✓ Solicitud de cotización enviada correctamente. Nos pondremos en contacto a la brevedad.';
        feedback.classList.remove('hidden');
        form.reset();
      }, 500);
    });
  }

  setupQuoteForm();
  document.addEventListener('astro:page-load', setupQuoteForm);
</script>

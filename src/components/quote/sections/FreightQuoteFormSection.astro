---
import type { Lang } from '../../../i18n/config.i18n';
import type { ServiceItem } from '../../../actions/services/services.action';
import quoteContent from '../../../data/site-quote-content.json';

interface Props {
  lang: Lang;
  service?: ServiceItem;
}

const { lang, service } = Astro.props;
const t = quoteContent[lang].labels;

const defaultSubject = service 
  ? `${t.subjectPrefix} ${service.title[lang] ?? service.title.es}`
  : t.defaultSubject;
---

<section class="w-full bg-white py-16 sm:py-24 text-neutral-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <form
      id="freight-quote-details-form"
      class="space-y-6"
      data-submitted={t.submitted}
      data-success={t.successNotice}
      data-error={t.errorNotice}
    >
      
      <!-- Row 1: First Name & Last Name -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="quote-first-name" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {t.firstName} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-first-name"
            name="firstName"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>

        <div>
          <label for="quote-last-name" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {t.lastName} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-last-name"
            name="lastName"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>
      </div>

      <!-- Row 2: Company Name & Email Address -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="quote-company" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {t.company} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-company"
            name="company"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>

        <div>
          <label for="quote-email" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {t.email} <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="quote-email"
            name="email"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>
      </div>

      <!-- Row 3: Commodity -->
      <div>
        <label for="quote-commodity" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
          {t.commodity} <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="quote-commodity"
          name="commodity"
          required
          class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
        />
      </div>

      <!-- Row 4: Pick Up Zip, Delivery Zip, Pick Up Date -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div>
          <label for="quote-pickup-zip" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {t.pickupZip} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-pickup-zip"
            name="pickupZip"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>

        <div>
          <label for="quote-delivery-zip" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {t.deliveryZip} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="quote-delivery-zip"
            name="deliveryZip"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>

        <div>
          <label for="quote-pickup-date" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
            {t.pickupDate} <span class="text-red-500">*</span>
          </label>
          <input
            type="date"
            id="quote-pickup-date"
            name="pickupDate"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>
      </div>

      <!-- Row 5: Subject -->
      <div>
        <label for="quote-subject" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
          {t.subject}
        </label>
        <input
          type="text"
          id="quote-subject"
          name="subject"
          value={defaultSubject}
          class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
        />
      </div>

      <!-- Row 6: Tell us what you need... -->
      <div>
        <label for="quote-details" class="block text-xs font-bold uppercase text-neutral-800 mb-1.5">
          {t.details} <span class="text-red-500">*</span>
        </label>
        <textarea
          id="quote-details"
          name="details"
          rows="5"
          required
          class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
        ></textarea>
      </div>

      <div id="quote-form-feedback" class="hidden p-3 bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold"></div>

      <!-- Centered Dark SUBMIT Button #222222 -->
      <div class="text-center pt-6">
        <button
          type="submit"
          id="quote-submit-btn"
          class="inline-block bg-[#222222] hover:bg-black text-white text-xs font-black uppercase tracking-widest px-14 py-4 rounded-none transition-colors"
        >
          {t.submit}
        </button>
      </div>

    </form>

  </div>
</section>

<script>
  import { actions } from 'astro:actions';

  function setupQuoteForm() {
    const form = document.getElementById('freight-quote-details-form') as HTMLFormElement | null;
    const feedback = document.getElementById('quote-form-feedback');
    const btn = document.getElementById('quote-submit-btn') as HTMLButtonElement | null;

    if (!form || !feedback || !btn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      const originalText = btn.textContent || '';
      btn.textContent = '...';
      feedback.classList.add('hidden');
      feedback.className = 'hidden p-3 text-xs font-bold';

      const formData = new FormData(form);
      const payload = {
        firstName: String(formData.get('firstName') || '').trim(),
        lastName: String(formData.get('lastName') || '').trim(),
        companyName: String(formData.get('company') || '').trim(),
        email: String(formData.get('email') || '').trim(),
        commodity: String(formData.get('commodity') || '').trim(),
        pickupZipCode: String(formData.get('pickupZip') || '').trim(),
        deliveryZipCode: String(formData.get('deliveryZip') || '').trim(),
        pickupDate: String(formData.get('pickupDate') || '').trim(),
        subject: String(formData.get('subject') || '').trim(),
        tellUsWhatYouNeed: String(formData.get('details') || '').trim(),
      };

      try {
        const { data, error } = await actions.submitQuoteForm(payload);
        if (error) {
          throw new Error(error.message || 'Error');
        }

        const submittedText = form.getAttribute('data-submitted') || 'SUBMITTED';
        const successNotice = form.getAttribute('data-success') || '✓ Done';

        btn.textContent = submittedText;
        feedback.textContent = successNotice;
        feedback.className = 'p-3 bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold';
        feedback.classList.remove('hidden');
        form.reset();

        setTimeout(() => {
          btn.disabled = false;
          btn.textContent = originalText;
        }, 4000);
      } catch (err: any) {
        btn.disabled = false;
        btn.textContent = originalText;
        const errorFallback = form.getAttribute('data-error') || 'Error sending quote request';
        feedback.textContent = `✗ ${err.message || errorFallback}`;
        feedback.className = 'p-3 bg-red-50 border border-red-300 text-red-800 text-xs font-bold';
        feedback.classList.remove('hidden');
      }
    });
  }

  setupQuoteForm();
  document.addEventListener('astro:page-load', setupQuoteForm);
</script>

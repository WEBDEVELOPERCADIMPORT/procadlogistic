---
import type { Lang } from "../../../i18n/config.i18n";
import ScaleIn from "@astroanimate/core/ScaleIn";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const shippers = {
  title: lang === "es" ? "CARGADORES" : "SHIPPERS",
  tagline:
    lang === "es"
      ? "Lo que necesite. Lo enviamos."
      : "You name it. We ship it.",
  cta: lang === "es" ? "CONOZCA MÁS" : "LEARN MORE",
  link: `/${lang}/shippers`,
};

const carriers = {
  title: lang === "es" ? "TRANSPORTISTAS" : "CARRIERS",
  tagline:
    lang === "es"
      ? "Conviértase en un socio confiable."
      : "Become a trusted partner.",
  cta: lang === "es" ? "CONOZCA MÁS" : "LEARN MORE",
  link: `/${lang}/contact`,
};
---

<section class="w-full bg-white py-16 sm:py-24 text-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      <!-- Card 1: SHIPPERS -->
      <ScaleIn duration={0.6} delay={0.05}>
        <div
          class="flex flex-col sm:flex-row bg-white border border-gray-100 shadow-sm overflow-hidden group hover:shadow-md transition-shadow duration-300"
        >
          <div class="w-full sm:w-1/2 h-56 sm:h-auto overflow-hidden bg-gray-100">
            <img
              src="/images/home/shippers-warehouse.png"
              alt={shippers.title}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div
            class="w-full sm:w-1/2 p-8 sm:p-10 flex flex-col items-center justify-center text-center space-y-4"
          >
            <h3
              class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-neutral-900"
            >
              {shippers.title}
            </h3>
            <p class="text-base text-neutral-600 italic">
              "{shippers.tagline}"
            </p>
            <div class="pt-2">
              <a
                href={shippers.link}
                class="relative inline-flex items-center justify-center bg-[#00aeef] hover:bg-[#0098d4] text-white text-xs font-black uppercase tracking-widest px-8 py-3.5 rounded-none shadow-md shadow-[#00aeef]/20 transition-all duration-200 transform hover:scale-[1.02] overflow-hidden group/btn"
              >
                <span class="relative z-10">{shippers.cta}</span>
                <span class="absolute inset-0 -translate-x-full group-hover/btn:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/30 to-transparent"></span>
              </a>
            </div>
          </div>
        </div>
      </ScaleIn>

      <!-- Card 2: CARRIERS -->
      <ScaleIn duration={0.6} delay={0.15}>
        <div
          class="flex flex-col sm:flex-row bg-white border border-gray-100 shadow-sm overflow-hidden group hover:shadow-md transition-shadow duration-300"
        >
          <div class="w-full sm:w-1/2 h-56 sm:h-auto overflow-hidden bg-gray-100">
            <img
              src="/images/home/carrier-truck.png"
              alt={carriers.title}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div
            class="w-full sm:w-1/2 p-8 sm:p-10 flex flex-col items-center justify-center text-center space-y-4"
          >
            <h3
              class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-neutral-900"
            >
              {carriers.title}
            </h3>
            <p class="text-base text-neutral-600 italic">
              "{carriers.tagline}"
            </p>
            <div class="pt-2">
              <a
                href={carriers.link}
                class="relative inline-flex items-center justify-center bg-[#00aeef] hover:bg-[#0098d4] text-white text-xs font-black uppercase tracking-widest px-8 py-3.5 rounded-none shadow-md shadow-[#00aeef]/20 transition-all duration-200 transform hover:scale-[1.02] overflow-hidden group/btn"
              >
                <span class="relative z-10">{carriers.cta}</span>
                <span class="absolute inset-0 -translate-x-full group-hover/btn:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/30 to-transparent"></span>
              </a>
            </div>
          </div>
        </div>
      </ScaleIn>
    </div>
  </div>
</section>

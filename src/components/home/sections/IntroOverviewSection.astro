---
import type { Lang } from '../../../i18n/config.i18n';
import FadeInText from '@astroanimate/core/FadeInText';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const title = lang === 'es' ? '¡SABEMOS DE LOGÍSTICA!' : 'WE KNOW LOGISTICS!';
---

<section class="w-full bg-white py-16 sm:py-20 text-neutral-900 border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
    
    <FadeInText duration={0.6} yOffset={20}>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-neutral-900">
        {title}
      </h2>
    </FadeInText>

    <FadeInText duration={0.7} delay={0.15} yOffset={20}>
      {lang === 'es' ? (
        <p class="text-base sm:text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
          Entregamos soluciones de transporte de carga y corretaje de fletes eficientes, <strong>aprovechando nuestra tecnología patentada, DASH</strong>, para optimizar las cadenas de suministro de nuestros clientes a través de un servicio ininterrumpido y capacidades dedicadas de carga en toda América del Norte.
        </p>
      ) : (
        <p class="text-base sm:text-lg text-neutral-700 leading-relaxed max-w-3xl mx-auto">
          Delivering comprehensive freight transportation and brokerage solutions, <strong>leveraging our proprietary technology, DASH</strong>, to streamline customer supply chains through around-the-clock service and dedicated multimodal capacity across North America.
        </p>
      )}
    </FadeInText>

    <div class="w-24 h-1 bg-[#00aeef] mx-auto mt-6"></div>

  </div>
</section>

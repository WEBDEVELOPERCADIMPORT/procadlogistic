---
import type { Lang } from "../../../i18n/config.i18n";
import FadeInText from "@astroanimate/core/FadeInText";
import homeContent from "../../../data/site-home-content.json";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeContent[lang] ?? homeContent.es;

const titleLine1 = t.hero.titleLine1;
const titleLine2 = t.hero.titleLine2;
const ctaLabel = t.hero.ctaLabel;
---

<section
  class="relative w-full min-h-[500px] sm:min-h-[600px] lg:min-h-[75vh] flex items-center justify-center overflow-hidden bg-neutral-100"
>
  <!-- 1. Background Train Image -->
  <img
    src="/images/home/hero-train.png"
    alt="ProCAD Freight Train Intermodal"
    class="absolute inset-0 w-full h-full object-cover object-center z-0"
    loading="eager"
  />

  <!-- 2. Translucent White Overlay Layer in front of image for readability -->
  <div class="absolute inset-0 bg-white/30 backdrop-blur-[0.5px] z-1"></div>

  <!-- 3. Headline & CTA Button in front of everything -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center flex flex-col items-center justify-center">
    <FadeInText duration={0.8} delay={0.1} yOffset={25}>
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-neutral-950 tracking-tight uppercase leading-[1.05] drop-shadow-sm">
        <span class="block">{titleLine1}</span>
        <span class="block">{titleLine2}</span>
      </h1>
    </FadeInText>

    <div class="mt-8 sm:mt-10">
      <FadeInText duration={0.6} delay={0.2} yOffset={15}>
        <a
          href={`/${lang}/quote`}
          class="relative inline-flex items-center justify-center bg-[#00aeef] hover:bg-[#0098d4] text-white text-xs sm:text-sm font-black uppercase tracking-widest px-10 sm:px-12 py-4 rounded-none shadow-xl shadow-[#00aeef]/25 transition-all duration-200 transform hover:scale-[1.02] active:scale-[0.98] overflow-hidden group cursor-pointer"
        >
          <span class="relative z-10">{ctaLabel}</span>
          <span class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/30 to-transparent"></span>
        </a>
      </FadeInText>
    </div>
  </div>
</section>

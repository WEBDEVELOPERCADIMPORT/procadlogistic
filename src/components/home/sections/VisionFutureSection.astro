---
import type { Lang } from '../../../i18n/config.i18n';
import FadeInText from '@astroanimate/core/FadeInText';
import homeContent from '../../../data/site-home-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeContent[lang] ?? homeContent.es;

const titleLine1 = t.vision.titleLine1;
const titleLine2 = t.vision.titleLine2;
const description = t.vision.description;
const ctaLabel = t.vision.cta;
---

<section class="w-full bg-[#f8f9fa] py-20 lg:py-28 text-neutral-900 border-t border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Bold Typography & CTA -->
      <div class="lg:col-span-6 space-y-6">
        <FadeInText duration={0.6} yOffset={25}>
          <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-neutral-900 leading-none">
            <span>{titleLine1}</span>
            <br />
            <span class="text-[#00aeef]">{titleLine2}</span>
          </h2>
        </FadeInText>

        <FadeInText duration={0.6} delay={0.1} yOffset={20}>
          <p class="text-base text-neutral-700 leading-relaxed max-w-xl">
            {description}
          </p>
        </FadeInText>

        <div class="pt-2">
          <a
            href={`/${lang}/`}
            class="relative inline-flex items-center justify-center bg-[#00aeef] hover:bg-[#0098d4] text-white text-xs font-black uppercase tracking-widest px-8 py-3.5 rounded-none shadow-md shadow-[#00aeef]/20 transition-all duration-200 transform hover:scale-[1.02] overflow-hidden group/btn"
          >
            <span class="relative z-10">{ctaLabel}</span>
            <span class="absolute inset-0 -translate-x-full group-hover/btn:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/30 to-transparent"></span>
          </a>
        </div>
      </div>

      <!-- Right Column: Operations Center Photograph -->
      <div class="lg:col-span-6">
        <div class="relative overflow-hidden bg-gray-200 shadow-lg group">
          <img
            src="/images/home/operations-center.png"
            alt="ProCAD Logistics Control Room"
            class="w-full h-80 sm:h-96 object-cover object-center group-hover:scale-102 transition-transform duration-500"
            loading="lazy"
          />
        </div>
      </div>

    </div>
  </div>
</section>

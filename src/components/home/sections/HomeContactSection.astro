---
import type { Lang } from '../../../i18n/config.i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const texts = {
  title: lang === 'es' ? '¿NECESITA MÁS INFORMACIÓN?' : 'NEED MORE INFORMATION?',
  subtitle: lang === 'es' ? 'CONTÁCTENOS HOY MISMO' : 'GET IN TOUCH WITH US TODAY',
  firstName: lang === 'es' ? 'Nombre' : 'First Name',
  lastName: lang === 'es' ? 'Apellido' : 'Last Name',
  email: lang === 'es' ? 'Correo Electrónico' : 'Email Address',
  subject: lang === 'es' ? 'Asunto' : 'Subject',
  message: lang === 'es' ? 'Mensaje' : 'Message',
  submit: lang === 'es' ? 'ENVIAR' : 'SUBMIT',
};
---

<section class="w-full bg-[#f8f9fa] py-20 lg:py-28 text-neutral-900 border-t border-gray-200">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-neutral-900">
      {texts.title}
    </h2>
    <p class="mt-2 text-xs uppercase tracking-widest font-bold text-[#00aeef]">
      {texts.subtitle}
    </p>

    <!-- Clean crisp form with border-gray-300 and rounded-none -->
    <form id="home-contact-form" class="mt-12 space-y-6 text-left">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="home-first-name" class="block text-xs font-bold uppercase text-neutral-700 mb-1">
            {texts.firstName} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="home-first-name"
            name="firstName"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>

        <div>
          <label for="home-last-name" class="block text-xs font-bold uppercase text-neutral-700 mb-1">
            {texts.lastName} <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="home-last-name"
            name="lastName"
            required
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label for="home-email" class="block text-xs font-bold uppercase text-neutral-700 mb-1">
          {texts.email} <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="home-email"
          name="email"
          required
          class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
        />
      </div>

      <div>
        <label for="home-subject" class="block text-xs font-bold uppercase text-neutral-700 mb-1">
          {texts.subject}
        </label>
        <input
          type="text"
          id="home-subject"
          name="subject"
          class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
        />
      </div>

      <div>
        <label for="home-message" class="block text-xs font-bold uppercase text-neutral-700 mb-1">
          {texts.message} <span class="text-red-500">*</span>
        </label>
        <textarea
          id="home-message"
          name="message"
          rows="4"
          required
          class="w-full px-4 py-3 bg-white border border-gray-300 rounded-none text-neutral-900 text-sm focus:border-[#00aeef] focus:outline-none"
        ></textarea>
      </div>

      <div id="home-form-feedback" class="hidden p-3 bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold"></div>

      <div class="text-center pt-4">
        <button
          type="submit"
          id="home-submit-btn"
          class="inline-block bg-[#222222] hover:bg-black text-white text-xs font-black uppercase tracking-widest px-12 py-4 rounded-none transition-colors"
        >
          {texts.submit}
        </button>
      </div>
    </form>

  </div>
</section>

<script>
  function setupHomeContact() {
    const form = document.getElementById('home-contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('home-form-feedback');
    const btn = document.getElementById('home-submit-btn') as HTMLButtonElement | null;

    if (!form || !feedback || !btn) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = '...';

      setTimeout(() => {
        btn.disabled = false;
        btn.textContent = 'ENVIADO';
        feedback.textContent = '✓ Mensaje enviado correctamente.';
        feedback.classList.remove('hidden');
        form.reset();
      }, 500);
    });
  }

  setupHomeContact();
  document.addEventListener('astro:page-load', setupHomeContact);
</script>

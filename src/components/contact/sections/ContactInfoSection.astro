---
import type { Lang } from '../../../i18n/config.i18n';
import contactContent from '../../../data/site-contact-content.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = contactContent[lang].channels;

const mapEmbedSrc = 'https://maps.google.com/maps?q=650+Centerpoint+Blvd%2C+New+Castle%2C+DE+19720&t=&z=15&ie=UTF8&iwloc=&output=embed';
const mapsUrl = 'https://maps.google.com/?q=650+Centerpoint+Blvd,+New+Castle,+DE+19720';
---

<section class="w-full bg-white py-16 sm:py-24 text-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Call Us & Email Us -->
      <div class="lg:col-span-5 space-y-10">
        
        <!-- Give us a call! -->
        <div class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#00aeef]">
            {t.callTitle}
          </h2>
          <div class="space-y-2 text-sm text-neutral-700">
            <p class="font-bold text-neutral-900">
              {t.hqLabel}
            </p>
            <p>
              <span class="font-semibold text-neutral-900">{t.directLabel}</span>{' '}
              <a href={`tel:${t.directPhone.replace(/\D/g, '')}`} class="hover:text-[#00aeef] transition-colors">{t.directPhone}</a>
            </p>
            <p>
              <span class="font-semibold text-neutral-900">{t.tollFreeLabel}</span>{' '}
              <a href={`tel:${t.tollFreePhone.replace(/\D/g, '')}`} class="hover:text-[#00aeef] transition-colors">{t.tollFreePhone}</a>
            </p>
            <p class="text-xs text-neutral-500 pt-1">
              {t.hoursNote}
            </p>
          </div>
        </div>

        <!-- Email us! -->
        <div class="space-y-4 pt-6 border-t border-gray-200">
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#00aeef]">
            {t.emailTitle}
          </h2>
          <div class="space-y-3 text-sm text-neutral-700">
            <div>
              <p class="font-bold text-neutral-900 text-xs uppercase tracking-wider">
                {t.quotesLabel}
              </p>
              <a href={`mailto:${t.quotesEmail}`} class="text-neutral-700 hover:text-[#00aeef] transition-colors">
                {t.quotesEmail}
              </a>
            </div>

            <div>
              <p class="font-bold text-neutral-900 text-xs uppercase tracking-wider">
                {t.carriersLabel}
              </p>
              <a href={`mailto:${t.carriersEmail}`} class="text-neutral-700 hover:text-[#00aeef] transition-colors">
                {t.carriersEmail}
              </a>
            </div>

            <div>
              <p class="font-bold text-neutral-900 text-xs uppercase tracking-wider">
                {t.marketingLabel}
              </p>
              <a href={`mailto:${t.marketingEmail}`} class="text-neutral-700 hover:text-[#00aeef] transition-colors">
                {t.marketingEmail}
              </a>
            </div>
          </div>
        </div>

        <!-- Address Badge -->
        <div class="p-4 bg-gray-50 border border-gray-200 text-xs text-neutral-600 space-y-1">
          <p class="font-bold text-neutral-900 uppercase">{t.companyName}</p>
          <p>{t.address}</p>
        </div>

      </div>

      <!-- Right Column: Responsive Google Map Embed -->
      <div class="lg:col-span-7">
        <div class="relative w-full h-96 sm:h-[480px] bg-gray-100 border border-gray-300 overflow-hidden shadow-xs group">
          <iframe
            title="ProCAD Logistic Location"
            src={mapEmbedSrc}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full"
          ></iframe>

          <!-- Floating "Open in Maps" Button -->
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="absolute top-4 left-4 z-10 inline-flex items-center gap-2 bg-[#00aeef] hover:bg-[#0098d4] text-white text-xs font-black uppercase tracking-wider px-4 py-2.5 shadow-md transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
            </svg>
            <span>{t.openInMaps}</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

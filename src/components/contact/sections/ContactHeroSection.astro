---
import type { Lang } from '../../../i18n/config.i18n';
import FadeInText from '@astroanimate/core/FadeInText';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const heroText = lang === 'es'
  ? 'CONTACTE A PROCAD LOGISTIC PARA SOLUCIONES DE TRANSPORTE'
  : 'CONTACT PROCAD LOGISTIC FOR TRANSPORTATION SOLUTIONS';
---

<section class="relative w-full h-72 sm:h-96 md:h-[420px] overflow-hidden flex items-center justify-center bg-neutral-100">
  <!-- Monochrome / Grayscale Operations Image -->
  <img
    src="/images/contact/hero-ops.png"
    alt="Operations Room"
    class="absolute inset-0 w-full h-full object-cover object-center grayscale z-0"
    loading="eager"
  />
  <div class="absolute inset-0 bg-white/40 backdrop-blur-[0.5px] z-1"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 text-center">
    <FadeInText duration={0.8} yOffset={25}>
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-neutral-950 uppercase tracking-tight leading-tight drop-shadow-sm">
        {heroText}
      </h1>
    </FadeInText>
  </div>
</section>

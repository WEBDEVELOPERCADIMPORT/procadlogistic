---
import type { Lang } from '../../../i18n/config.i18n';
import serviceContent from '../../../data/site-service-content.json';
import FadeInText from '@astroanimate/core/FadeInText';

interface Props {
  lang: Lang;
  currentSlug?: string;
}

const { lang, currentSlug } = Astro.props;
const t = serviceContent[lang].stressFree;
const quoteUrl = currentSlug ? `/${lang}/quote?service=${currentSlug}` : `/${lang}/quote`;
---

<section class="w-full bg-[#1c2430] py-16 px-4 text-center text-white">
  <div class="max-w-4xl mx-auto flex flex-col items-center justify-center space-y-6">
    
    <!-- Title with FREE in Cyan -->
    <FadeInText duration={0.6} yOffset={20}>
      <h2 class="text-3xl sm:text-5xl md:text-6xl font-black uppercase tracking-tight flex items-center justify-center gap-3">
        <span>{t.titlePrefix} <span class="text-[#00aeef]">{t.titleHighlight}</span></span>
      </h2>
    </FadeInText>

    <!-- Down Chevron Icon -->
    <div class="text-[#00aeef]">
      <svg class="w-8 h-8 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" />
      </svg>
    </div>

    <!-- Cyan Button with Shimmer Effect -->
    <div class="pt-2">
      <a
        href={quoteUrl}
        class="relative inline-flex items-center justify-center bg-[#00aeef] hover:bg-[#0098d4] text-white text-xs sm:text-sm font-black uppercase tracking-widest px-10 py-4 rounded-none shadow-xl shadow-[#00aeef]/25 transition-all duration-200 transform hover:scale-[1.02] overflow-hidden group cursor-pointer"
      >
        <span class="relative z-10">{t.quoteButtonText}</span>
        <span class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/30 to-transparent"></span>
      </a>
    </div>

  </div>
</section>

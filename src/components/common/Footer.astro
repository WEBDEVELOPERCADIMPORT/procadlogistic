---
import { getLangFromUrl } from '../../i18n/utils.i18n';
import type { Lang } from '../../i18n/config.i18n';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);

const socialLinks = [
  { name: 'LinkedIn', url: 'https://linkedin.com/company/procadlogistic', icon: 'linkedin' },
  { name: 'Email', url: 'mailto:marketing@procadlogistic.com', icon: 'email' },
  { name: 'Instagram', url: 'https://instagram.com/procadlogistic', icon: 'instagram' },
  { name: 'Facebook', url: 'https://facebook.com/procadlogistic', icon: 'facebook' },
  { name: 'YouTube', url: 'https://youtube.com/@procadlogistic', icon: 'youtube' },
];

const footerLinks = [
  { label: lang === 'es' ? 'CARRERAS' : 'CAREERS', path: 'careers' },
  { label: 'DASH', path: 'dash' },
  { label: lang === 'es' ? 'CONTACTO' : 'CONTACT', path: 'contact' },
  { label: lang === 'es' ? 'TÉRMINOS Y CONDICIONES' : 'TERMS AND CONDITIONS', path: 'terms' },
];
---

<footer class="w-full bg-[#edebe8] py-14 px-6 text-neutral-800">
  <div class="max-w-7xl mx-auto flex flex-col items-center justify-center space-y-8 text-center">
    
    <!-- Social Icons Row (Dark boxes #222222 with white icons) -->
    <div class="flex items-center justify-center gap-3">
      {socialLinks.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="w-10 h-10 rounded-sm bg-[#222222] text-white flex items-center justify-center hover:bg-[#00aeef] transition-colors shadow-xs"
          aria-label={item.name}
          title={item.name}
        >
          {item.icon === 'linkedin' && (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.79v8.37H6.46v-8.37M7.86 6.78a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24Z" />
            </svg>
          )}
          {item.icon === 'email' && (
            <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          )}
          {item.icon === 'instagram' && (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a3.999 3.999 0 1 1 0-7.998 3.999 3.999 0 0 1 0 7.998zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" />
            </svg>
          )}
          {item.icon === 'facebook' && (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          )}
          {item.icon === 'youtube' && (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          )}
        </a>
      ))}
    </div>

    <!-- Navigation Links Row -->
    <nav class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3" aria-label="Footer Navigation">
      {footerLinks.map((link) => (
        <a
          href={`/${lang}/${link.path}`}
          class="text-xs font-black uppercase tracking-widest text-neutral-900 hover:text-[#00aeef] transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Bottom Legal Line -->
    <div class="pt-4 border-t border-neutral-300/80 w-full max-w-4xl">
      <p class="text-[11px] uppercase tracking-wider font-semibold text-neutral-600 leading-relaxed">
        PROCAD LOGISTIC, 650 CENTERPOINT BLVD, NEW CASTLE, DELAWARE 19720, UNITED STATES | 3174750960 | MARKETING@PROCADLOGISTIC.COM
      </p>
    </div>

  </div>
</footer>

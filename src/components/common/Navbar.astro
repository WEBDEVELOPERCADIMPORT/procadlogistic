---
import { getLangFromUrl } from "../../i18n/utils.i18n";
import type { Lang } from "../../i18n/config.i18n";
import servicesData from "../../data/services/services.data.json";
import globalContent from "../../data/site-global-content.json";

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

const t = globalContent[lang] ?? globalContent.es;

const switchLangPath =
  lang === "es"
    ? currentPath.replace(/^\/es/, "/en")
    : currentPath.replace(/^\/en/, "/es");

const isShippersActive = currentPath.includes('/shippers') || currentPath.includes('/services');
const isContactActive = currentPath.includes('/contact');
const isAboutActive = currentPath === `/${lang}/` || currentPath === `/${lang}` || currentPath.includes('/about');

const servicesList = servicesData.services;

const navItems = t.nav;
const aboutItem = navItems.find((item) => item.id === 'about');
const shippersItem = navItems.find((item) => item.id === 'shippers');
const contactItem = navItems.find((item) => item.id === 'contact');

const dropdownTitle = t.navbar.servicesDropdownTitle;
const viewAllLabel = t.navbar.viewAllServices;
const quoteLabel = t.navbar.quoteCta.label;
const langSwitchTitle = t.navbar.langSwitchTitle;
const langSwitchLabel = t.navbar.langSwitchLabel;
---

<header class="sticky top-0 z-50 w-full bg-white border-b border-gray-100 shadow-xs transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a
        href={`/${lang}/`}
        class="flex items-center transition-opacity hover:opacity-90 focus:outline-none"
        aria-label="ProCAD Logistic Home"
      >
        <img
          src="/logo.png"
          alt="ProCAD Logistic"
          class="h-10 sm:h-12 w-auto object-contain"
        />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-8" aria-label="Main Navigation">
        
        <!-- ABOUT US (Points to Home) -->
        <a
          href={`/${lang}/`}
          class={`text-xs uppercase tracking-widest font-extrabold transition-colors py-2 ${
            isAboutActive ? 'text-[#00aeef]' : 'text-neutral-800 hover:text-[#00aeef]'
          }`}
        >
          {aboutItem?.label}
        </a>

        <!-- SHIPPERS with Services Dropdown -->
        <div class="relative group" id="shippers-dropdown-wrapper">
          <div class="flex items-center gap-1">
            <a
              href={`/${lang}/shippers`}
              class={`text-xs uppercase tracking-widest font-extrabold transition-colors py-2 ${
                isShippersActive ? 'text-[#00aeef]' : 'text-neutral-800 hover:text-[#00aeef]'
              }`}
            >
              {shippersItem?.label}
            </a>
            
            <button
              type="button"
              id="shippers-dropdown-toggle"
              class="p-1 text-neutral-600 hover:text-[#00aeef] transition-colors focus:outline-none"
              aria-label="Toggle Services Dropdown"
              aria-expanded="false"
            >
              <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>

          <!-- Services Dropdown Menu -->
          <div
            id="shippers-dropdown-menu"
            class="absolute left-0 top-full pt-2 w-72 hidden group-hover:block z-50"
          >
            <div class="bg-white border border-gray-200 rounded-none shadow-xl py-2">
              <div class="px-4 py-2 border-b border-gray-100 bg-gray-50/80">
                <p class="text-[10px] font-black uppercase tracking-widest text-[#00aeef]">
                  {dropdownTitle}
                </p>
              </div>

              {servicesList.map((service) => {
                const serviceTitle = service.title[lang] ?? service.title.es;
                const isCurrent = currentPath.includes(`/services/${service.slug}`);
                return (
                  <a
                    href={`/${lang}/services/${service.slug}`}
                    class={`block px-4 py-2.5 text-xs font-bold uppercase tracking-wider transition-colors border-l-2 ${
                      isCurrent
                        ? 'border-[#00aeef] bg-cyan-50/50 text-[#00aeef]'
                        : 'border-transparent text-neutral-700 hover:text-[#00aeef] hover:bg-gray-50 hover:border-[#00aeef]'
                    }`}
                  >
                    {serviceTitle}
                  </a>
                );
              })}

              <div class="px-4 py-2 mt-1 border-t border-gray-100 bg-gray-50/50">
                <a
                  href={`/${lang}/shippers`}
                  class="text-[11px] font-black uppercase tracking-wider text-[#00aeef] hover:underline flex items-center justify-between"
                >
                  <span>{viewAllLabel}</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- CONTACT -->
        <a
          href={`/${lang}/contact`}
          class={`text-xs uppercase tracking-widest font-extrabold transition-colors py-2 ${
            isContactActive ? 'text-[#00aeef]' : 'text-neutral-800 hover:text-[#00aeef]'
          }`}
        >
          {contactItem?.label}
        </a>

      </nav>

      <!-- Right Actions: Language Switcher + Mobile Toggle -->
      <div class="flex items-center space-x-4">
        
        <!-- Language Switcher Pill -->
        <a
          href={switchLangPath}
          class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-black uppercase tracking-wider text-neutral-700 bg-gray-100 hover:bg-[#00aeef] hover:text-white transition-all rounded-full border border-gray-200"
          title={langSwitchTitle}
        >
          {langSwitchLabel}
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden p-2 text-neutral-800 hover:text-[#00aeef] focus:outline-none"
          aria-label="Toggle Mobile Menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-nav-menu" class="hidden md:hidden bg-white border-t border-gray-200 px-4 pt-3 pb-6 space-y-3">
    <a
      href={`/${lang}/`}
      class={`block px-3 py-2 text-xs uppercase tracking-widest font-bold ${
        isAboutActive ? 'text-[#00aeef]' : 'text-neutral-800 hover:text-[#00aeef]'
      }`}
    >
      {aboutItem?.label}
    </a>

    <div>
      <div class="flex items-center justify-between px-3 py-2 text-xs uppercase tracking-widest font-bold text-neutral-800">
        <a href={`/${lang}/shippers`} class="hover:text-[#00aeef]">{shippersItem?.label}</a>
        <button type="button" id="mobile-services-accordion-btn" class="p-1 text-neutral-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>

      <div id="mobile-services-list" class="hidden pl-5 space-y-1 py-1 border-l-2 border-gray-100 ml-3">
        {servicesList.map((service) => (
          <a
            href={`/${lang}/services/${service.slug}`}
            class="block py-1 text-xs font-semibold uppercase text-neutral-600 hover:text-[#00aeef]"
          >
            {service.title[lang] ?? service.title.es}
          </a>
        ))}
      </div>
    </div>

    <a
      href={`/${lang}/contact`}
      class={`block px-3 py-2 text-xs uppercase tracking-widest font-bold ${
        isContactActive ? 'text-[#00aeef]' : 'text-neutral-800 hover:text-[#00aeef]'
      }`}
    >
      {contactItem?.label}
    </a>

    <div class="pt-2 px-3">
      <a
        href={`/${lang}/quote`}
        class="block text-center bg-[#00aeef] text-white text-xs font-black uppercase tracking-widest py-3 rounded-none shadow-sm"
      >
        {quoteLabel}
      </a>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-nav-menu');
    const accordionBtn = document.getElementById('mobile-services-accordion-btn');
    const accordionList = document.getElementById('mobile-services-list');
    const shippersToggle = document.getElementById('shippers-dropdown-toggle');
    const shippersMenu = document.getElementById('shippers-dropdown-menu');

    if (mobileBtn && mobileMenu) {
      mobileBtn.onclick = () => {
        const isHidden = mobileMenu.classList.toggle('hidden');
        mobileBtn.setAttribute('aria-expanded', String(!isHidden));
      };
    }

    if (accordionBtn && accordionList) {
      accordionBtn.onclick = () => {
        accordionList.classList.toggle('hidden');
      };
    }

    if (shippersToggle && shippersMenu) {
      shippersToggle.onclick = (e) => {
        e.stopPropagation();
        shippersMenu.classList.toggle('hidden');
      };
    }
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>

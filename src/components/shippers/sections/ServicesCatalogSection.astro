---
import type { Lang } from '../../../i18n/config.i18n';
import type { ServiceItem } from '../../../actions/services/services.action';
import defaultServicesData from '../../../data/services/services.data.json';

interface Props {
  lang: Lang;
  services?: ServiceItem[];
}

const { lang, services } = Astro.props;

const servicesList: ServiceItem[] = (services && services.length > 0)
  ? services
  : (defaultServicesData.services as ServiceItem[]);

const headerTitle = lang === 'es' ? 'LO QUE NECESITE. LO ENVIAMOS.' : 'YOU NAME IT. WE SHIP IT.';
const overviewLabel = lang === 'es' ? 'VISIÓN GENERAL' : 'OVERVIEW';
const learnMoreLabel = lang === 'es' ? 'CONOZCA MÁS' : 'LEARN MORE';
---

<section class="w-full bg-white py-16 sm:py-24 text-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Sidebar: Services Navigation -->
      <aside class="lg:col-span-3 space-y-4">
        <div class="sticky top-28 bg-[#f8f9fa] p-6 border border-gray-200">
          <p class="text-xs font-black uppercase tracking-widest text-[#00aeef] mb-4">
            {overviewLabel}
          </p>
          <ul class="space-y-3">
            {servicesList.map((s) => (
              <li>
                <a
                  href={`/${lang}/services/${s.slug}`}
                  class="block text-xs font-black uppercase tracking-wider text-neutral-800 hover:text-[#00aeef] transition-colors"
                >
                  {s.title[lang] ?? s.title.es}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <!-- Right Main Content: Header + 3-Column Grid -->
      <div class="lg:col-span-9 space-y-10">
        <div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-neutral-900">
            {headerTitle}
          </h2>
          {lang === 'es' ? (
            <p class="mt-4 text-base text-neutral-700 leading-relaxed max-w-3xl">
              Respaldados por nuestra tecnología propietaria y una red integral de transporte de carga, ofrecemos <strong>soluciones integradas de corretaje</strong> que garantizan capacidad, puntualidad y eficiencia operativa.
            </p>
          ) : (
            <p class="mt-4 text-base text-neutral-700 leading-relaxed max-w-3xl">
              Backed by our proprietary logistics platform and trusted carrier network, we provide <strong>comprehensive brokerage solutions</strong> engineered for maximum certainty, capacity, and cost-efficiency.
            </p>
          )}
        </div>

        <!-- 3-Column Services Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {servicesList.map((service) => {
            const title = service.title[lang] ?? service.title.es;
            const tagline = service.tagline[lang] ?? service.tagline.es;
            const serviceUrl = `/${lang}/services/${service.slug}`;

            return (
              <div class="flex flex-col bg-white border border-gray-200 overflow-hidden shadow-xs group">
                <div class="h-48 overflow-hidden bg-gray-100">
                  <img
                    src={service.image}
                    alt={title}
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>

                <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                  <div>
                    <h3 class="text-base font-black uppercase tracking-tight text-neutral-900 group-hover:text-[#00aeef] transition-colors">
                      {title}
                    </h3>
                    <p class="mt-2 text-xs text-neutral-600 leading-relaxed line-clamp-3">
                      {tagline}
                    </p>
                  </div>

                  <div class="pt-2">
                    <a
                      href={serviceUrl}
                      class="inline-block bg-black hover:bg-[#00aeef] text-white text-[11px] font-black uppercase tracking-widest px-6 py-2.5 rounded-none transition-colors"
                    >
                      {learnMoreLabel}
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

      </div>

    </div>
  </div>
</section>

---
import type { Lang } from '../../../i18n/config.i18n';
import type { ServiceItem } from '../../../actions/services/services.action';
import defaultServicesData from '../../../data/services/services.data.json';
import shippersContent from '../../../data/site-shippers-content.json';
import FadeInText from '@astroanimate/core/FadeInText';
import ScaleIn from '@astroanimate/core/ScaleIn';

interface Props {
  lang: Lang;
  services?: ServiceItem[];
}

const { lang, services } = Astro.props;
const t = shippersContent[lang] ?? shippersContent.es;

const servicesList: ServiceItem[] = (services && services.length > 0)
  ? services
  : (defaultServicesData.services as ServiceItem[]);

const headerTitle = t.catalog.title;
const headerSubtitle = t.catalog.subtitle;
const overviewLabel = t.catalog.overviewLabel;
const learnMoreLabel = t.catalog.learnMore;
---

<section class="w-full bg-white py-16 sm:py-24 text-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Sidebar: Services Navigation -->
      <aside class="lg:col-span-3 space-y-4">
        <div class="sticky top-28 bg-[#f8f9fa] p-6 border border-gray-200">
          <p class="text-xs font-black uppercase tracking-widest text-[#00aeef] mb-4">
            {overviewLabel}
          </p>
          <ul class="space-y-3">
            {servicesList.map((s) => (
              <li>
                <a
                  href={`/${lang}/services/${s.slug}`}
                  class="block text-xs font-black uppercase tracking-wider text-neutral-800 hover:text-[#00aeef] transition-colors"
                >
                  {s.title[lang] ?? s.title.es}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <!-- Right Main Content: Header + 3-Column Grid -->
      <div class="lg:col-span-9 space-y-10">
        <div>
          <FadeInText duration={0.6} yOffset={20}>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-neutral-900">
              {headerTitle}
            </h2>
          </FadeInText>
          <FadeInText duration={0.6} delay={0.1} yOffset={15}>
            <p class="mt-4 text-base text-neutral-700 leading-relaxed max-w-3xl">
              {headerSubtitle}
            </p>
          </FadeInText>
        </div>

        <!-- 3-Column Services Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {servicesList.map((service, index) => {
            const title = service.title[lang] ?? service.title.es;
            const tagline = service.tagline[lang] ?? service.tagline.es;
            const serviceUrl = `/${lang}/services/${service.slug}`;

            return (
              <ScaleIn duration={0.5} delay={index * 0.08}>
                <div class="flex flex-col h-full bg-white border border-gray-200 overflow-hidden shadow-xs hover:shadow-md transition-shadow group">
                  <div class="h-48 overflow-hidden bg-gray-100">
                    <img
                      src={service.image}
                      alt={title}
                      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>

                  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                    <div>
                      <h3 class="text-base font-black uppercase tracking-tight text-neutral-900 group-hover:text-[#00aeef] transition-colors">
                        {title}
                      </h3>
                      <p class="mt-2 text-xs text-neutral-600 leading-relaxed line-clamp-3">
                        {tagline}
                      </p>
                    </div>

                    <div class="pt-2">
                      <a
                        href={serviceUrl}
                        class="inline-block bg-black hover:bg-[#00aeef] text-white text-[11px] font-black uppercase tracking-widest px-6 py-2.5 rounded-none transition-colors duration-200"
                      >
                        {learnMoreLabel}
                      </a>
                    </div>
                  </div>
                </div>
              </ScaleIn>
            );
          })}
        </div>

      </div>

    </div>
  </div>
</section>
